{
  "profile_id": "core",
  "description": "General rules for Russian scientific and technical prose. Applied to every run.",
  "latin_allow": [
    "a", "ad", "al", "cf", "de", "e", "et", "etc", "g", "hoc", "i", "ibid",
    "in", "m", "n", "novo", "p", "posteriori", "priori", "r", "rho", "sic",
    "silico", "situ", "versus", "via", "vitro", "vivo", "vs"
  ],
  "rules": [
    {
      "code": "mixed_english",
      "severity": "error",
      "pattern": "(?i)(?<![\\w-])(?:narrative review|journal articles?|full texts?|evidence|meta-analysis|cut-?offs?|thresholds?|reproducibility|workflow|fallback|retries|production-ready|performance|claims?|sites?|tasks?|populations?|eligible|supported|bounded|unsupported)(?![\\w-])",
      "message": "Use a precise Russian equivalent or introduce the foreign term once."
    },
    {
      "code": "hybrid_verb",
      "severity": "error",
      "pattern": "(?i)(?<![а-яё])(?:ретра(?:ить|ится|ил[аи]?|ено)|фетч(?:ить|ится|ил[аи]?|ено)|кэшировать|мерж(?:ить|ится|ил[аи]?|ено)|пуш(?:ить|ится|ил[аи]?|ено)|парс(?:ить|ится|ил[аи]?|ено)|логировать|депло(?:ить|ится|ил[аи]?|ено))(?![а-яё])",
      "message": "Replace the hybrid verb with a Russian description of the action."
    },
    {
      "code": "mixed_script_word",
      "severity": "error",
      "pattern": "(?<![A-Za-zА-Яа-яЁё])(?:(?:[A-Z][a-z]+|[a-z]+)-[А-Яа-яЁё]+|[А-Яа-яЁё]+-(?:[A-Z][a-z]+|[a-z]+))(?![A-Za-zА-Яа-яЁё])",
      "message": "Replace mixed-script word formation with a normative Russian phrase."
    },
    {
      "code": "empty_metaphrase",
      "severity": "warning",
      "pattern": "(?i)(?<![а-яё])(?:важно отметить|следует отметить|нельзя не отметить|очевидно|в целом)(?![а-яё])",
      "message": "Remove the metaphrase if the sentence keeps its meaning."
    },
    {
      "code": "unsupported_booster",
      "severity": "warning",
      "pattern": "(?i)(?<![а-яё])(?:критически важно|ключев(?:ая роль|ую роль)|значительно улучшает|оптимальн(?:ый|ая|ое|ые)|высокоэффективн(?:ый|ая|ое|ые))(?![а-яё])",
      "message": "Give a criterion or replace the evaluation with an exact observation."
    },
    {
      "code": "vague_calque",
      "severity": "warning",
      "pattern": "(?i)(?<![а-яё])(?:это про|в части|на уровне|в рамках)(?![а-яё])",
      "message": "Name the exact action, object, relation, or condition."
    }
  ]
}
