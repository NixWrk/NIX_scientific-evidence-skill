{
  "profile_id": "genre-review",
  "description": "Языковые риски обзора: неисчисленная поддержка, репутация вместо метода, молчание источников как согласие, абсолютная уверенность и подмена нулевого результата отсутствием эффекта.",
  "latin_allow": [],
  "rules": [
    {
      "code": "unquantified_support",
      "severity": "warning",
      "pattern": "(?i)(?<![а-яё])(?:ряд (?:исследован\\w+|работ|авторов)|многочисленн\\w+ (?:исследован\\w+|работ\\w*)|большинство (?:авторов|исследован\\w+|работ)|мног(?:ие|их) (?:исследован\\w+|работ\\w*|авторов)|во многих (?:работах|исследованиях))(?![а-яё])",
      "message": "Назови число независимых исследований и их дизайны."
    },
    {
      "code": "prestige_as_evidence",
      "severity": "warning",
      "pattern": "(?i)(?<![а-яё])(?:авторитетн\\w+ (?:журнал\\w*|издани\\w+|источник\\w*)|высокоцитируем\\w+|общепризнан\\w+|широко известно|классическ\\w+ работа|золотой стандарт)(?![а-яё])",
      "message": "Замени ссылку на репутацию описанием методической пригодности источника для этого утверждения."
    },
    {
      "code": "absence_as_agreement",
      "severity": "warning",
      "pattern": "(?i)(?<![а-яё])(?:противоречий не (?:выявлено|обнаружено|найдено)|расхождений не (?:выявлено|обнаружено|найдено)|данные не противоречат)(?![а-яё])",
      "message": "Отдели отсутствие данных от согласия между исследованиями."
    },
    {
      "code": "undifferentiated_summary",
      "severity": "warning",
      "pattern": "(?i)(?<![а-яё])(?:в (?:данной|этой) (?:работе|статье) (?:авторы )?(?:рассматрива\\w+|описыва\\w+|представл\\w+)|как показано в (?:работе|статье))(?![а-яё])",
      "message": "Синтезируй материал по темам вместо последовательного пересказа источников."
    },
    {
      "code": "absolute_certainty",
      "severity": "warning",
      "pattern": "(?i)(?<![а-яё])(?:доказано,? что|неоспоримо,? что|однозначно (?:доказыва\\w+|подтвержда\\w+|свидетельству\\w+)|безусловно установлено,? что)(?![а-яё])",
      "message": "Ограничь формулировку дизайнами, условиями и составом корпуса."
    },
    {
      "code": "null_as_nonexistence",
      "severity": "warning",
      "pattern": "(?i)(?<![а-яё])(?:эффект|связь|влияние|различи\\w*) (?:полностью )?отсутству(?:ет|ют)(?![а-яё])",
      "message": "Укажи, что не было выявлено и при каких условиях; статистическая незначимость не доказывает отсутствия эффекта."
    }
  ]
}
