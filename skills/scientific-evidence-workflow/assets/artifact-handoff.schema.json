{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/scientific-evidence-workflow/artifact-handoff.schema.json",
  "title": "Versioned scientific artifact handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "handoff_id",
    "record_version",
    "supersedes",
    "artifact",
    "producer",
    "validation",
    "selection_policy",
    "automation_status",
    "consumers"
  ],
  "properties": {
    "schema_version": {"enum": ["1.0", "1.1"]},
    "handoff_id": {"$ref": "#/$defs/identifier"},
    "record_version": {"$ref": "#/$defs/version"},
    "supersedes": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/identifier"}
      ]
    },
    "artifact": {"$ref": "#/$defs/artifact"},
    "producer": {"$ref": "#/$defs/producer"},
    "reasoning_context": {"$ref": "#/$defs/reasoning_context"},
    "validation": {"$ref": "#/$defs/validation"},
    "selection_policy": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/selection_policy"}
      ]
    },
    "automation_status": {"enum": ["blocked", "permitted"]},
    "consumers": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/consumer"}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"schema_version": {"const": "1.1"}},
        "required": ["schema_version"]
      },
      "then": {
        "required": ["reasoning_context"]
      }
    },
    {
      "if": {
        "properties": {
          "selection_policy": {
            "type": "object",
            "properties": {"status": {"const": "conflicted"}},
            "required": ["status"]
          }
        },
        "required": ["selection_policy"]
      },
      "then": {
        "properties": {"automation_status": {"const": "blocked"}}
      }
    },
    {
      "if": {
        "properties": {"automation_status": {"const": "permitted"}},
        "required": ["automation_status"]
      },
      "then": {
        "properties": {
          "validation": {
            "properties": {
              "technical": {"const": "passed"},
              "computational": {"const": "passed"},
              "scientific": {"enum": ["bounded", "approved"]}
            }
          },
          "selection_policy": {
            "not": {
              "type": "object",
              "properties": {"status": {"const": "conflicted"}},
              "required": ["status"]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"record_version": {"const": "v1"}},
        "required": ["record_version"]
      },
      "then": {
        "properties": {"supersedes": {"type": "null"}}
      }
    },
    {
      "if": {
        "properties": {
          "record_version": {
            "type": "string",
            "pattern": "^v(?:[2-9]|[1-9][0-9]+)$"
          }
        },
        "required": ["record_version"]
      },
      "then": {
        "properties": {"supersedes": {"$ref": "#/$defs/identifier"}}
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^v[1-9][0-9]*$"
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nonempty": {
      "type": "string",
      "minLength": 1
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "artifact_version",
        "content_hash",
        "path",
        "media_type",
        "schema_ref",
        "units",
        "scientific_status",
        "applicability_limits"
      ],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/identifier"},
        "artifact_version": {"$ref": "#/$defs/version"},
        "content_hash": {"$ref": "#/$defs/hash"},
        "path": {"$ref": "#/$defs/nonempty"},
        "media_type": {"$ref": "#/$defs/nonempty"},
        "schema_ref": {"$ref": "#/$defs/nonempty"},
        "units": {"$ref": "#/$defs/nonempty"},
        "scientific_status": {
          "enum": [
            "measurement",
            "estimate",
            "bound",
            "reference",
            "approximation",
            "model_prediction",
            "placeholder",
            "hypothesis",
            "decision"
          ]
        },
        "applicability_limits": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/nonempty"}
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["notebook_id", "run_id", "code_version"],
      "properties": {
        "notebook_id": {"$ref": "#/$defs/identifier"},
        "run_id": {"$ref": "#/$defs/identifier"},
        "code_version": {"$ref": "#/$defs/hash"}
      }
    },
    "reasoning_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis_refs",
        "established",
        "unresolved_question",
        "decision_rationale",
        "next_task",
        "expected_observations",
        "evaluation_criterion"
      ],
      "properties": {
        "basis_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonempty"}
        },
        "established": {"$ref": "#/$defs/nonempty"},
        "unresolved_question": {"$ref": "#/$defs/nonempty"},
        "decision_rationale": {"$ref": "#/$defs/nonempty"},
        "next_task": {"$ref": "#/$defs/nonempty"},
        "expected_observations": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/nonempty"}
        },
        "evaluation_criterion": {"$ref": "#/$defs/nonempty"}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["technical", "computational", "scientific"],
      "properties": {
        "technical": {"enum": ["not_checked", "passed", "failed", "blocked"]},
        "computational": {"enum": ["not_checked", "partial", "passed", "failed", "blocked"]},
        "scientific": {"enum": ["not_reviewed", "bounded", "approved", "rejected", "conflicted"]}
      }
    },
    "selection_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "policy_version",
        "status",
        "rule_ids",
        "conflict_refs",
        "resolution_ref"
      ],
      "properties": {
        "policy_id": {"$ref": "#/$defs/identifier"},
        "policy_version": {"$ref": "#/$defs/version"},
        "status": {"enum": ["clear", "conflicted", "resolved"]},
        "rule_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "conflict_refs": {
          "type": "array",
          "items": {"$ref": "#/$defs/nonempty"}
        },
        "resolution_ref": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/nonempty"}
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"status": {"const": "clear"}},
            "required": ["status"]
          },
          "then": {
            "properties": {
              "conflict_refs": {"maxItems": 0},
              "resolution_ref": {"type": "null"}
            }
          }
        },
        {
          "if": {
            "properties": {"status": {"const": "conflicted"}},
            "required": ["status"]
          },
          "then": {
            "properties": {
              "conflict_refs": {"minItems": 2},
              "resolution_ref": {"type": "null"}
            }
          }
        },
        {
          "if": {
            "properties": {"status": {"const": "resolved"}},
            "required": ["status"]
          },
          "then": {
            "properties": {
              "conflict_refs": {"minItems": 2},
              "resolution_ref": {"$ref": "#/$defs/nonempty"}
            }
          }
        }
      ]
    },
    "consumer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consumer_id", "purpose", "acceptance_criterion"],
      "properties": {
        "consumer_id": {"$ref": "#/$defs/identifier"},
        "purpose": {"$ref": "#/$defs/nonempty"},
        "acceptance_criterion": {"$ref": "#/$defs/nonempty"}
      }
    }
  }
}
