  "evidence": [
    {"evidence_id": "EV-DATA-SCOPE", "source_id": "SRC-STATUS", "locator": "раздел:Исходные данные", "claim": "В реестре зафиксированы 40 пар: 10 COPDgene и 30 LungCT; экспертные ориентиры доступны для 13 пар, а у NIX, GEORG и YAROSLAV имеется только КТ глубокого вдоха.", "support_type": "direct", "fragment": null, "value": {"pairs": 40, "copdgene": 10, "lungct": 30, "expert_pairs": 13}, "unit": "случаи", "study_context": "Исходные КТ-данные проекта", "limitations": "Наборы различаются по популяции и полю обзора.", "verification_status": "verified"},
    {"evidence_id": "EV-MEASURAND", "source_id": "SRC-MEASUREMENT", "locator": "раздел:Измерительная цепочка и D-044", "claim": "Целевая величина h определена как полный путь от поверхности лёгкого наружу к границе тела; после D-044 тканевый компонент объединяет жир, мышцу и прочие мягкие ткани.", "support_type": "method", "fragment": null, "value": null, "unit": null, "study_context": "Измерение грудной стенки", "limitations": "Величина не является толщиной одной мышцы.", "verification_status": "verified"},
    {"evidence_id": "EV-LIT-NONIDENT", "source_id": "SRC-LIT-GEOMETRY", "locator": "разделы:2 и 8", "claim": "В предоставленном литературном корпусе переход от одной КТ к геометрии другой дыхательной фазы ограничен неидентифицируемостью; дополнительные наблюдения и граничные условия влияют на точность сильнее тонкой настройки материала.", "support_type": "context", "fragment": null, "value": null, "unit": null, "study_context": "Обзор 19 записей Zotero", "limitations": "Обзор не является систематическим и не подтверждён повторным поиском на дату рукописи.", "verification_status": "verified"},
    {"evidence_id": "EV-LIT-SLIDING", "source_id": "SRC-LIT-GEOMETRY", "locator": "разделы:2.1 и 2.4", "claim": "Контакт на плевральной границе и тангенциальное скольжение представлены в литературе как существенные свойства дыхательной деформации.", "support_type": "context", "fragment": null, "value": null, "unit": null, "study_context": "Работы Al-Mayah, Werner, Eom и Amelon в предоставленном обзоре", "limitations": "Опубликованные модели используют парные фазы или дополнительные индивидуальные наблюдения.", "verification_status": "verified"},
    {"evidence_id": "EV-LIT-REGIONAL", "source_id": "SRC-LIT-GEOMETRY", "locator": "разделы:2.4 и 2.5", "claim": "Деформация лёгких и грудной клетки регионально неоднородна.", "support_type": "context", "fragment": null, "value": null, "unit": null, "study_context": "Работы Amelon, Bastir и Vergari в предоставленном обзоре", "limitations": "Популяции и дыхательные манёвры различаются.", "verification_status": "verified"},
    {"evidence_id": "EV-LIT-WALL-REGIONAL", "source_id": "SRC-LIT-WALL", "locator": "разделы:1–3", "claim": "В предоставленном УЗ-корпусе изменение межрёберной мышцы и полного пути от кожи зависит от анатомической точки и может менять знак между зонами.", "support_type": "context", "fragment": null, "value": null, "unit": null, "study_context": "Восемь публикаций, обзор от 2026-08-03", "limitations": "УЗ-величины и конечные анатомические границы не тождественны h по КТ.", "verification_status": "verified"},
    {"evidence_id": "EV-LIT-WALL-GAP", "source_id": "SRC-LIT-WALL", "locator": "раздел:Чего в литературе нет", "claim": "В предоставленном восьмипубликационном корпусе нет карты изменения h по всей грудной клетке.", "support_type": "limitation", "fragment": null, "value": 8, "unit": "публикации", "study_context": "Локальная подколлекция Zotero", "limitations": "Утверждение относится только к предоставленному корпусу, а не ко всей опубликованной литературе.", "verification_status": "verified"},
    {"evidence_id": "EV-S11-CAUSE", "source_id": "SRC-DECISIONS", "locator": "решение:D-027", "claim": "Основной отказ S1.1 на реальных данных локализован в нормальной проекции, которая отбрасывает локальную тангенциальную составляющую; шести глобальных мод недостаточно для её восстановления.", "support_type": "direct", "fragment": null, "value": null, "unit": null, "study_context": "Поэтапная диагностика зафиксированного алгоритма", "limitations": "Вывод относится к проверенному классу представления.", "verification_status": "verified"},
    {"evidence_id": "EV-S12-CAUSE", "source_id": "SRC-DECISIONS", "locator": "решение:D-029", "claim": "В S1.2 сглаживание сохраняло топологию, но нарушало контакт, а усиление нормальной связи сохраняло контакт, но нарушало топологию; установлен структурный конфликт класса эвристик.", "support_type": "direct", "fragment": null, "value": null, "unit": null, "study_context": "Зафиксированная проверка пяти полей", "limitations": "Вывод не распространяется на иные классы совместных моделей.", "verification_status": "verified"},
    {"evidence_id": "EV-J12-CAUSE", "source_id": "SRC-DECISIONS", "locator": "решения:D-038–D-040", "claim": "Функция потерь J1.2 удерживала границу как множество, но не идентифицировала тангенциальное соответствие; оптимизация сходилась к почти склеенному решению.", "support_type": "direct", "fragment": null, "value": null, "unit": null, "study_context": "Синтетические случаи с известной истиной", "limitations": "Для разных случаев дополнительно различались информативность дескриптора и успешность оптимизации.", "verification_status": "verified"},
    {"evidence_id": "EV-RIB-CAUSE", "source_id": "SRC-DECISIONS", "locator": "решения:D-052, D-054–D-056", "claim": "Рёберная система координат оказалась неоднозначной: сдвиг якоря сопоставим с межрёберным шагом, а ширина промежутка сама зависит от дыхания; после заранее заданного условия остановки ветвь закрыта.", "support_type": "direct", "fragment": null, "value": null, "unit": null, "study_context": "Три последовательные предварительные проверки и внешний УЗ-контекст", "limitations": "Отрицательный результат относится к COPDgene с шагом среза 2,5 мм.", "verification_status": "verified"},
    {"evidence_id": "EV-E1-CAUSE", "source_id": "SRC-DECISIONS", "locator": "решение:D-053", "claim": "Эйлерова карта смешивает изменение измеряемой величины с перемещением стенки через неподвижную сетку; оценка артефакта сопоставима с наблюдаемым сигналом.", "support_type": "limitation", "fragment": null, "value": null, "unit": null, "study_context": "Диагностическая карта десяти COPDgene", "limitations": "Карта не является биологической оценкой изменения толщины.", "verification_status": "verified"},
    {"evidence_id": "EV-TRANSFER", "source_id": "SRC-STATUS", "locator": "раздел:Ограничения, данные COPDgene и добровольцев", "claim": "Перенос результатов COPDgene на здоровых добровольцев не подтверждён: COPDgene включает курильщиков и больных ХОБЛ, а у добровольцев нет парной КТ выдоха.", "support_type": "limitation", "fragment": null, "value": null, "unit": null, "study_context": "Границы применимости проекта", "limitations": "Индивидуальная проверка на NIX, GEORG и YAROSLAV невозможна по имеющимся данным.", "verification_status": "verified"},
    {"evidence_id": "EV-FINAL-BOUNDARY", "source_id": "SRC-STATUS", "locator": "разделы:Что известно и чего нет;Текущий итог", "claim": "В проекте не получены индивидуальная валидированная геометрия выдоха, парная карта изменения h и проверка на добровольцах.", "support_type": "limitation", "fragment": null, "value": null, "unit": null, "study_context": "Канонический статус на 2026-08-03", "limitations": null, "verification_status": "verified"}
