  "claims": [
    {"claim_id": "CL-AIM", "text": "Работа оценивает, позволяют ли имеющиеся данные и проверенные вычислительные модели получить валидированное описание перехода от вдоха к выдоху и изменения пути через грудную стенку.", "output_section": "Цель и задачи", "claim_type": "method", "certainty": "direct", "evidence_ids": ["EV-DATA-SCOPE", "EV-MEASURAND"], "result_ids": [], "status": "supported", "disposition": "keep", "boundary": null, "causal_basis": null},
    {"claim_id": "CL-LIT-NONIDENT", "text": "Одна КТ вдоха не определяет единственную геометрию выдоха; опубликованные подходы опираются на дополнительные наблюдения, парные фазы или граничные условия.", "output_section": "Обзор литературы", "claim_type": "synthesis", "certainty": "inferred", "evidence_ids": ["EV-LIT-NONIDENT"], "result_ids": [], "status": "bounded", "disposition": "keep_with_boundary", "boundary": "Вывод относится к предоставленному обзору 19 записей, а не к исчерпывающему поиску.", "causal_basis": null},
    {"claim_id": "CL-LIT-REGIONAL", "text": "Регионарность и плевральное скольжение необходимо учитывать при оценке дыхательной деформации.", "output_section": "Обзор литературы", "claim_type": "synthesis", "certainty": "inferred", "evidence_ids": ["EV-LIT-SLIDING", "EV-LIT-REGIONAL", "EV-LIT-WALL-REGIONAL"], "result_ids": [], "status": "bounded", "disposition": "keep_with_boundary", "boundary": "Исследования различаются по данным, популяциям и определению измеряемой величины.", "causal_basis": null},
    {"claim_id": "CL-REG", "text": "ConvexAdam улучшил среднюю ошибку ориентиров относительно Elastix во всех 13 экспертных случаях, но полный гейт не прошёл ни один случай.", "output_section": "Результаты", "claim_type": "numeric", "certainty": "direct", "evidence_ids": [], "result_ids": ["RES-REG"], "status": "supported", "disposition": "keep", "boundary": null, "causal_basis": null},
    {"claim_id": "CL-S11", "text": "S1.1 прошёл четыре синтетических случая, но не прошёл ни одного из шести реальных случаев разработки.", "output_section": "Результаты", "claim_type": "numeric", "certainty": "direct", "evidence_ids": [], "result_ids": ["RES-S11-SYN", "RES-S11-REAL"], "status": "supported", "disposition": "keep", "boundary": null, "causal_basis": null},
    {"claim_id": "CL-S11-CAUSE", "text": "Отказ S1.1 на реальных данных обусловлен потерей локальной тангенциальной составляющей при нормальной проекции и недостаточностью шести глобальных мод.", "output_section": "Результаты", "claim_type": "causal", "certainty": "direct", "evidence_ids": ["EV-S11-CAUSE"], "result_ids": ["RES-S11-DIAG"], "status": "supported", "disposition": "keep", "boundary": null, "causal_basis": "Поэтапная диагностика одного и того же зафиксированного конвейера показала резкое ухудшение после нормальной проекции."},
    {"claim_id": "CL-S12-CAUSE", "text": "Класс эвристических исправлений S1.2 отвергнут из-за воспроизводимого конфликта между контактом и топологией.", "output_section": "Результаты", "claim_type": "causal", "certainty": "direct", "evidence_ids": ["EV-S12-CAUSE"], "result_ids": ["RES-S12"], "status": "supported", "disposition": "keep", "boundary": null, "causal_basis": "На всех пяти полях сглаживание и нормальная связь давали взаимно противоположные результаты по двум гейтам."},
    {"claim_id": "CL-J-NUMERIC", "text": "Численная реализация и представление совместного кусочного поля скоростей прошли проверки J1.0 и J1.1.", "output_section": "Результаты", "claim_type": "numeric", "certainty": "direct", "evidence_ids": [], "result_ids": ["RES-J10", "RES-J11"], "status": "supported", "disposition": "keep", "boundary": null, "causal_basis": null},
    {"claim_id": "CL-J12-DISCRETIZATION", "text": "Провал растровой проверки контактно-валидного фантома v2 был вызван пространственной дискретизацией и исчез на уточнённой сетке v3.", "output_section": "Результаты", "claim_type": "causal", "certainty": "direct", "evidence_ids": [], "result_ids": ["RES-J12-V2", "RES-J12-V3"], "status": "supported", "disposition": "keep", "boundary": null, "causal_basis": "Аналитическая геометрия оставалась корректной, а при изменении только разрешения растровый гейт изменился с 0/3 на 3/3."},
    {"claim_id": "CL-J12-OPT", "text": "Зафиксированная оптимизация J1.2 не восстановила тангенциальное скольжение ни в одном из девяти запусков и сходилась к почти склеенному решению.", "output_section": "Результаты", "claim_type": "causal", "certainty": "direct", "evidence_ids": ["EV-J12-CAUSE"], "result_ids": ["RES-J12-DEV", "RES-J12-ID"], "status": "supported", "disposition": "keep", "boundary": null, "causal_basis": "Контакт и топология сохранялись при почти нулевой оценке скольжения относительно известной ненулевой истины; дополнительные проверки отделили этот отказ от ошибки направления."},
    {"claim_id": "CL-W1", "text": "W1 подтвердил воспроизводимость суммарного мягкотканного пути внутри одной фазы, но не измерял дыхательный эффект и не подтверждал точность относительно анатомической истины.", "output_section": "Результаты", "claim_type": "numeric", "certainty": "direct", "evidence_ids": ["EV-MEASURAND"], "result_ids": ["RES-W1"], "status": "supported", "disposition": "keep", "boundary": null, "causal_basis": null},
    {"claim_id": "CL-W2", "text": "W2 не выбрал пространственное разрешение, удовлетворяющее одновременно порогам шума и заполненности в обеих фазах.", "output_section": "Результаты", "claim_type": "numeric", "certainty": "direct", "evidence_ids": [], "result_ids": ["RES-W2"], "status": "supported", "disposition": "keep", "boundary": null, "causal_basis": null},
    {"claim_id": "CL-RIB", "text": "Рёберная система координат не прошла три последовательные предварительные проверки; основной содержательный отказ — неоднозначность якоря, сопоставимая с межрёберным шагом.", "output_section": "Результаты", "claim_type": "causal", "certainty": "direct", "evidence_ids": ["EV-RIB-CAUSE"], "result_ids": ["RES-RIB"], "status": "supported", "disposition": "keep", "boundary": null, "causal_basis": "После исправления фазозависимого осевого окна неоднозначность сохранилась у 7/10 случаев и совпала с независимыми анатомическими свидетельствами."},
    {"claim_id": "CL-E1", "text": "Числа E1 являются диагностикой, а не измерением биологического изменения, поскольку артефакт системы координат сопоставим с наблюдаемыми величинами.", "output_section": "Результаты", "claim_type": "limitation", "certainty": "direct", "evidence_ids": ["EV-E1-CAUSE"], "result_ids": ["RES-E1"], "status": "supported", "disposition": "keep", "boundary": null, "causal_basis": null},
    {"claim_id": "CL-NO-FINAL-GEOMETRY", "text": "По имеющимся данным не получены валидированная индивидуальная геометрия выдоха и парная карта изменения h.", "output_section": "Обсуждение", "claim_type": "limitation", "certainty": "direct", "evidence_ids": ["EV-FINAL-BOUNDARY"], "result_ids": ["RES-REG", "RES-S11-REAL", "RES-J12-DEV", "RES-RIB", "RES-E1"], "status": "supported", "disposition": "keep", "boundary": null, "causal_basis": null},
    {"claim_id": "CL-TRANSFER", "text": "Результаты COPDgene нельзя считать проверенными для NIX, GEORG и YAROSLAV.", "output_section": "Ограничения", "claim_type": "limitation", "certainty": "direct", "evidence_ids": ["EV-TRANSFER"], "result_ids": [], "status": "supported", "disposition": "keep", "boundary": null, "causal_basis": null},
    {"claim_id": "CL-WALL-NOVELTY", "text": "В предоставленном восьмипубликационном корпусе не выявлена карта изменения полного пути по всей грудной клетке.", "output_section": "Обсуждение", "claim_type": "factual", "certainty": "direct", "evidence_ids": ["EV-LIT-WALL-GAP"], "result_ids": [], "status": "bounded", "disposition": "keep_with_boundary", "boundary": "Заявление ограничено предоставленной подколлекцией и не является доказательством отсутствия публикаций вообще.", "causal_basis": null},
    {"claim_id": "CL-CONCLUSION", "text": "Проверенная последовательность отделила численную состоятельность отдельных компонентов от их пригодности для реальных анатомических измерений и предотвратила интерпретацию диагностических карт как биологического эффекта.", "output_section": "Заключение", "claim_type": "synthesis", "certainty": "inferred", "evidence_ids": ["EV-E1-CAUSE", "EV-FINAL-BOUNDARY"], "result_ids": ["RES-J10", "RES-J11", "RES-S11-REAL", "RES-J12-DEV", "RES-RIB", "RES-E1"], "status": "bounded", "disposition": "keep_with_boundary", "boundary": "Вывод относится к выполненным проверкам и зафиксированным порогам данного проекта.", "causal_basis": null}
  ]
